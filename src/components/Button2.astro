const color800 = colorMap800[language] || "var(--neutral800)";
const color700 = colorMap700[language] || "var(--neutral700)";
const color600 = colorMap600[language] || "var(--neutral600)";
const color500 = colorMap500[language] || "var(--neutral500)";
const color400 = colorMap400[language] || "var(--neutral400)";
const color300 = colorMap300[language] || "var(--neutral300)";
const color200 = colorMap200[language] || "var(--neutral200)";
const color100 = colorMap100[language] || "var(--neutral100)";
---

<style define:vars={{ color500, color400, color300, color200, color100 }}>
  .btn:hover {
    background: var(--neutral200);
  }
</style>

<a href={path}>
  <div class="btn">
    <h1>{id}. {title}</h1>
    <h2>{subtitle}</h2>
  </div>
</a>

<style>
  .btn {
    position: relative;
    background-color: transparent;
    padding: 1.5rem;
    transition: all 0.4s;
    background-color: var(--white);
    border-radius: 10px;
  }

  .btn > h1 {
    position: relative;
    font-family: "Inter", sans-serif;
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 0.5rem;
    transition: 0.4s all;
  }

  .btn > h2 {
    position: relative;
    font-family: "Inter", sans-serif;
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 0rem;
    color: var(--neutral500);
    transition: 0.4s all;
  }

  .btn > p {
    position: absolute;
    font-family: "Inter", sans-serif;
    left: 1.5rem;
    bottom: 0;
  }

  /* Mobile */
  @media (max-width: 1280px) {
    .btn {
      position: relative;
      background-color: var(--white);
      padding: 1.5rem;
      transition: all 0.4s;
      border: none;
      border-radius: 0px;
      margin-bottom: 1rem;
    }

    .btn > h1 {
      font-size: 20px;
    }

    .btn > h2 {
      font-size: 15px;
      font-weight: 500;
    }
  }
</style>
