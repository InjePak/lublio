  rus: "var(--indigo100)",
  tur: "var(--red100)",
  pol: "var(--pink100)",
  ces: "var(--purple100)",
  hun: "var(--lime100)",
  nld: "var(--orange100)",
  swe: "var(--blue100)",
  dan: "var(--rose100)",
  lux: "var(--cyan100)",
