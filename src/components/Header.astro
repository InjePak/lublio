---
import "../styles/fonts.css";
import "../styles/colors.css";
import "../styles/transition.css";
import { Icon } from "astro-icon/components";

// Logo
import LogoSVG from "../../public/lublio-logo-light.svg?raw";
---

<header id="main-header" class="header">
  <div class="logo">
    <a href="/">
      <Fragment set:html={LogoSVG} />
    </a>
  </div>
  <!-- <div class="menu-button">
    <a href="/">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="100%"
        height="100%"
        viewBox="0 0 24 24"
      >
        <path d="M0 0h24v24H0z" fill="none"></path>
        <path fill="currentColor" d="M3 18v-2h18v2zm0-5v-2h18v2zm0-5V6h18v2z"
        ></path>
      </svg>
    </a>
  </div> -->
  <ul class="menu">
    <li>
      <a href="/english" class="menu-link">영어</a>
    </li>
    <li>
      <a href="/french" class="menu-link">프랑스어</a>
    </li>
    <li>
      <a href="/german" class="menu-link">독일어</a>
    </li>
    <li>
      <a href="/italian" class="menu-link">이탈리아어</a>
    </li>
    <li>
      <a href="/russian" class="menu-link">러시아어</a>
    </li>
    <li>
      <a href="/turkish" class="menu-link">튀르키예어</a>
    </li>
    <li>
      <a href="/hebrew" class="menu-link">히브리어</a>
    </li>
    <li>
      <a href="/kazakh" class="menu-link">카자흐어</a>
    </li>
  </ul>
</header>

<script>
  // Overlay Menu 로직
  const overlay = document.getElementById("overlay-menu");
  const openBtn = document.getElementById("menu-open-btn");
  const closeBtn = document.getElementById("menu-close-btn");

  openBtn?.addEventListener("click", () => {
    overlay?.classList.add("overlayActive"); // styles.overlayActive 역할
  });

  closeBtn?.addEventListener("click", () => {
    overlay?.classList.remove("overlayActive");
  });
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    justify-self: left;
    width: 200px;
    height: 100%;
    z-index: 99;
    transition: all 0.4s;
    padding: 1.5rem 0;
    background-color: var(--neutral100);
    border-right: 1px solid var(--neutral400);
  }

  .logo {
    position: relative;
    width: 60px;
    height: 60px;
    margin: 0 auto;
    padding: 0.7rem;
    transition: 0.4s all;
  }

  .logo > a {
    width: 100%;
    height: 100%;
  }

  .logo :global(svg) {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
  }

  .logo:hover {
    cursor: pointer;
    background-color: var(--neutral200);
    border-radius: 10px;
  }

  .menu-button {
    display: none;
  }

  .menu {
    position: absolute;
    display: block;
    top: 50%;
    transform: translateY(-50%);
    width: 100%;
    height: auto;
    padding: 1rem 0;
    text-align: center;
  }

  .menu > li {
    width: auto;
    margin-bottom: 1rem;
  }

  .menu > li:last-child {
    margin-bottom: 0rem;
  }

  .menu-link {
    display: inline-block;
    font-family: "Inter", sans-serif;
    font-size: 20px;
    font-weight: 600;
    color: var(--neutral700);
    padding: 0.5rem 1rem;
    transition: 0.4s all;
  }

  .menu-link:hover {
    background-color: var(--neutral200);
    border-radius: 15px;
  }

  @media (max-width: 1280px) {
    .header {
      position: fixed;
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      top: 0;
      justify-self: left;
      width: 100%;
      height: 60px;
      z-index: 99;
      transition: all 0.4s;
      padding: 0;
      background-color: rgba(245, 245, 245, 0.7);
      border-right: none;
    }

    .logo {
      position: relative;
      width: 45px;
      height: 45px;
      margin: 5px 10px;
      padding: 0.7rem;
      transition: 0.4s all;
    }

    .menu-button {
      position: relative;
      display: block;
      width: 45px;
      height: 45px;
      margin: 5px 10px;
      padding: 0.7rem;
      transition: 0.4s all;
    }

    .menu-button > a > svg {
      color: var(--neutral800);
    }

    .menu-button:hover {
      cursor: pointer;
      background-color: var(--neutral200);
      border-radius: 10px;
    }

    .menu {
      display: none;
    }
  }
</style>

<script></script>
