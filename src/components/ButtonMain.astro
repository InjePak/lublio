---

<style define:vars={{ color500, color400, color300, color200, color100 }}>
  .btn > h3 {
    color: var(--color400);
  }

  .btn {
    background: linear-gradient(
      -45deg,
      var(--stone300),
      var(--stone100),
      var(--stone300)
    );
    background-size: 300% 300%;
    animation: gradient 4s ease infinite;
  }

  @keyframes gradient {
    0% {
      background-position: 0% 50%;
    }

    50% {
      background-position: 100% 50%;
    }

    100% {
      background-position: 0% 50%;
    }
  }

  .btn:hover > h1,
  .btn:hover > h2,
  .btn:hover > p {
    color: var(--color500);
  }

  .btn:hover > h3 {
    opacity: 1;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
</style>

<a href={path}>
  <div class="btn">
    <img
      alt="Flag"
      src={`https://purecatamphetamine.github.io/country-flag-icons/3x2/${langToCountryCode[language]}.svg`}
    />
    <h1>{title}</h1>
    <h2>{subtitle}</h2>
    <p>{description}</p>
    <h3>{greeting}</h3>
  </div>
</a>

<style>
  .btn {
    position: relative;
    padding: 1.2rem;
    width: 100%;
    height: 100%;
    transition: all 0.4s;
    /* border-radius: 10px; */
  }

  .btn > img {
    display: inline-block;
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    height: 18px;
    transform: translateY(2px);
    border-radius: 2px;
    margin-right: 0.5rem;
  }

  .btn > h1 {
    position: relative;
    font-family: "Inter", sans-serif;
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 0rem;
    transition: all 0.4s;
  }

  .btn > h2 {
    position: relative;
    font-family: "Inter", sans-serif;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 0rem;
    color: var(--neutral500);
    transition: all 0.4s;
    transform: translateY(-5px);
  }

  .btn > p {
    display: inline-block;
    position: absolute;
    right: 1.2rem;
    bottom: 1rem;
    text-align: right;
    margin-top: 1rem;
    margin-bottom: 0rem;
    font-size: 13px;
    font-weight: 600;
    color: var(--neutral500);
  }

  .btn > h3 {
    position: absolute;
    text-align: center;
    margin: 0;
    top: 60%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: "Inter", sans-serif;
    text-transform: uppercase;
    width: 90%;
    font-size: 14px;
    font-weight: 700;
    color: var(--neutral800);
    opacity: 0;
    transition: all 0.4s;
  }

  /* Mobile */
  @media (max-width: 1280px) {
    .btn {
      padding: 1rem;
      min-height: 160px;
      border-radius: 0px;
    }

    .btn > img {
      top: 1rem;
      right: 1rem;
      height: 16px;
      border-radius: 2px;
      margin-right: 0.3rem;
    }

    .btn > h1 {
      font-size: 22px;
    }

    .btn > h2 {
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 0rem;
    }

    .btn > h3 {
      font-size: 14px;
    }

    .btn > p {
      font-size: 13px;
      font-weight: 600;
      right: 1rem;
      bottom: 1rem;
    }
  }
</style>
