---

<style
  define:vars={{
    color800,
    color700,
    color600,
    color500,
    color400,
    color300,
    color200,
    color100,
  }}
>
  .phrase-box > p > span {
    display: inline-block;
    text-transform: uppercase;
    width: 80px;
    font-weight: 500;
    direction: ltr;
    color: var(--neutral800);
    border-bottom: 2px solid var(--color400);
    margin-bottom: 2rem;
  }
</style>

<div class={`phrase-box ${className} riseUp_1`}>
  {
    data.map((phrase, i) => (
      <p lang={language}>
        <span>{i + 1}</span>
        <br />
        {/* <img
          alt={languageName}
          src={`https://purecatamphetamine.github.io/country-flag-icons/3x2/${flag}.svg`}
        /> */}
        {phrase}
      </p>
    ))
  }
</div>

<style>
  .phrase-box {
    margin-bottom: 1.5rem;
  }

  .phrase-box > h2 {
    text-align: left;
  }

  .phrase-box > p {
    display: inline-block;
    text-align: left;
    width: 100%;
    padding: 2rem 3rem;
    font-size: 20px;
    font-weight: 500;
    line-height: 2rem;
    margin-bottom: 1.5rem;
    hyphens: auto;
    overflow-wrap: break-word;
    font-family: "Google Sans", sans-serif;
    background-color: var(--white);
  }

  .phrase-box > p > img {
    display: inline-block;
    height: 18px;
    transform: translateY(1px);
    border-radius: 2px;
    margin-right: 0.5rem;
  }

  .phrase-box > h1,
  .phrase-box > p {
    color: var(--neutral800);
  }

  @media (max-width: 1280px) {
    .phrase-box > p {
      padding: 2rem;
      font-size: 18px;
      line-height: 26px;
      margin-bottom: 1rem;
      border: none;
      border-radius: 0px;
    }

    .phrase-box > p > img {
      display: block;
      height: 14px;
      transform: translateY(0px);
      border-radius: 2px;
      margin-bottom: 1rem;
    }

    .phrase-box > h1,
    .phrase-box > p {
      color: var(--neutral800);
    }
  }
</style>
