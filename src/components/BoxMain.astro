  spa: "var(--apricot200)",
  por: "var(--green200)",
  fra: "var(--sky200)",
  deu: "var(--amber200)",
  ita: "var(--emerald200)",
  rus: "var(--indigo200)",
  tur: "var(--red200)",
  pol: "var(--pink200)",
  ces: "var(--purple200)",
  hun: "var(--lime200)",
  nld: "var(--orange200)",
  swe: "var(--blue200)",
  dan: "var(--rose200)",
  lux: "var(--cyan200)",
};
const colorMap100: Record<string, string> = {
  eng: "var(--periwinkle100)",
  spa: "var(--apricot100)",
  por: "var(--green100)",
  fra: "var(--sky100)",
  deu: "var(--amber100)",
  ita: "var(--emerald100)",
  rus: "var(--indigo100)",
  tur: "var(--red100)",
  pol: "var(--pink100)",
  ces: "var(--purple100)",
  hun: "var(--lime100)",
  nld: "var(--orange100)",
  swe: "var(--blue100)",
  dan: "var(--rose100)",
  lux: "var(--cyan100)",
};
const color800 = colorMap800[language] || "var(--neutral800)";
const color700 = colorMap700[language] || "var(--neutral700)";
const color600 = colorMap600[language] || "var(--neutral600)";
const color500 = colorMap500[language] || "var(--neutral500)";
const color400 = colorMap400[language] || "var(--neutral400)";
const color300 = colorMap300[language] || "var(--neutral300)";
const color200 = colorMap200[language] || "var(--neutral200)";
const color100 = colorMap100[language] || "var(--neutral100)";

const greetingMap: Record<string, string> = {
  eng: "HELLO",
  spa: "HOLA",
  por: "OLA",
  deu: "HALLO",
  ita: "CIAO",
  rus: "PRIVET",
  tur: "SELAM",
  pol: "CZESC",
  ces: "AHOJ",
  hun: "SZIA",
  nld: "HOI",
  swe: "HEJ",
  dan: "HEJ",
  lux: "MOIEN",
};
const greeting = greetingMap[language] || "HELLO";
---

<style
  define:vars={{
    color800,
    color700,
    color600,
    color500,
    color400,
    color300,
    color200,
    color100,
  }}
>
  .box-right,
  .box-top {
    background: linear-gradient(
      -45deg,
      var(--color200),
      var(--color100),
      var(--color200),
      var(--color100),
      var(--color200),
      var(--color100),
      var(--color200)
    );
    background-size: 700% 700%;
    animation: gradient 4s ease infinite;
  }

  @keyframes gradient {
    0% {
      background-position: 0% 50%;
    }

    50% {
      background-position: 100% 50%;
    }

    100% {
      background-position: 0% 50%;
    }
  }

  .box-right > .white-gradient {
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to right,
      rgba(245, 245, 245, 1),
      rgba(245, 245, 245, 0) 60%,
      rgba(245, 245, 245, 0)
    );
    padding: 1.5rem;
  }

  .box-top > .white-gradient {
    width: 100%;
    height: 100%;
    padding: 1.5rem;
  }

  .box-right > .white-gradient > h3,
  .box-top > .white-gradient > h3 {
    color: var(--color400);
  }
</style>

<div class="box riseUp_1">
  <div class="box-top">
    <div class="white-gradient">
      <h3>{greeting}</h3>
    </div>
  </div>
  <div class="box-left">
    <h1 class="riseUp_2">{title}</h1>
    <h2 class="riseUp_3">{subtitle}</h2>
    <p class="riseUp_4">{description}</p>
  </div>
  <div class="box-right">
    <div class="white-gradient">
      <h3>{greeting}</h3>
      <h3>{greeting}</h3>
      <h3>{greeting}</h3>
      <h3>{greeting}</h3>
    </div>
  </div>
</div>

<style>
  .box {
    position: relative;
    display: flex;
    width: 100%;
    aspect-ratio: 1 / 1;
    height: 380px;
    margin-bottom: 2rem;
    outline: none;
    z-index: 0;
    text-decoration: none;
    transition: all 1s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .box-left {
    width: 50%;
    padding-top: 1rem;
    padding: 1.5rem;
  }

  .box-left > h1 {
    position: relative;
    font-family: "Inter", sans-serif;
    text-transform: uppercase;
    display: inline;
    font-size: 40px;
    font-weight: 700;
    line-height: 1;
    word-break: keep-all;
    word-wrap: break-word;
    transition: all 0.4s;
  }

  .box-left > h2 {
    position: relative;
    font-family: "Inter", sans-serif;
    display: block;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: 0px;
    line-height: 1;
    margin-top: 1rem;
    transition: all 0.4s;
  }

  .box-left > p {
    position: absolute;
    bottom: 0;
    margin-bottom: 1.5rem;
    width: calc(50% - 3rem);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0px;
    line-height: 1.4;
    transition: all 0.4s;
  }

  .box > p:last-child {
    margin-bottom: 0px;
  }

  .box-left > h1,
  .box-left > h2,
  .box-left > p {
    color: var(--neutral700);
  }

  .box-right {
    width: 50%;
    height: 100%;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
  }

  .box-right > .white-gradient > h3 {
    position: relative;
    display: block;
    text-align: right;
    width: 100%;
    font-family: "Fjalla One", sans-serif;
    text-transform: uppercase;
    font-size: 90px;
    font-weight: 600;
    line-height: 84px;
    margin-bottom: 0;
  }

  .box-top {
    display: none;
  }

  /* Mobile */
  @media (max-width: 1280px) {
    .box {
      position: relative;
      display: flex;
      flex-direction: column;
      width: 100%;
      aspect-ratio: 0;
      height: 500px;
      margin-bottom: 1rem;
      outline: none;
      z-index: 0;
      text-decoration: none;
      transition: all 1s cubic-bezier(0.19, 1, 0.22, 1);
    }

    .box-left {
      width: 100%;
      padding: 1.5rem;
    }

    .box-left > h1 {
      font-size: 40px;
      line-height: 1rem;
    }

    .box-left > h2 {
      font-size: 22px;
      line-height: 1.6rem;
      margin-top: 0.5rem;
    }

    .box-left > p {
      position: absolute;
      font-family: "Inter", sans-serif;
      width: calc(100% - 3rem);
      left: 1.5rem;
      bottom: 1.5rem;
      font-size: 16px;
      font-weight: 500;
      letter-spacing: 0px;
      line-height: 1.4;
      transition: all 0.4s;
    }

    .box-left > p:last-child {
      margin-bottom: 0px;
    }

    .box-right {
      display: none;
    }

    .box-top {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      width: 100%;
      height: 40px;
      margin-bottom: 1.5rem;
    }

    .box-top > .white-gradient > h3 {
      position: relative;
      display: block;
      text-align: right;
      font-family: "Inter", sans-serif;
      text-transform: uppercase;
      font-size: 20px;
      font-weight: 700;
      line-height: 3px;
      margin: 0rem;
      margin-right: 0.5rem;
    }
  }
</style>
