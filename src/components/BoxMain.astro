  fra: "var(--sky400)",
  deu: "var(--amber400)",
  ita: "var(--emerald400)",
  rus: "var(--indigo400)",
  tur: "var(--red400)",
  pol: "var(--pink400)",
  ces: "var(--purple400)",
  hun: "var(--lime400)",
