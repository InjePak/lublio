---
interface Props {
  numberOfColumns: "1" | "2" | "3" | "4" | "5" | "6";
  data: Record<string, string[]>;
  tableWidth?: string;
}

const { numberOfColumns, data, tableWidth = "100%" } = Astro.props;

const object = Object.entries(data)
  .map(([key, value]) => ({ key, value }))
  .slice(0, Number(numberOfColumns));
---

<div class="table-wrapper">
  <div class="table-horizontal" style={`width: ${tableWidth};`}>
    {
      object.map(({ key, value }) => (
        <div class="column">
          <div class="columnHeader">
            <p>{key}</p>
          </div>
          {value?.map((row) => (
            <div class="row">
              <p>{row}</p>
            </div>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .table-wrapper {
    position: relative;
  }

  .table-horizontal {
    display: table;
    table-layout: fixed;
    width: 100%;
    margin-right: auto;
    font-family: "Inter", "Noto Hebrew", sans-serif;
    font-weight: 400;
    letter-spacing: 0px;
    margin-bottom: 20px;
    border-collapse: collapse;
    border-left: 1px solid var(--neutral400);
    border-right: 1px solid var(--neutral400);
    border-top: 1px solid var(--neutral400);
  }

  .column {
    display: table-cell;
    text-align: left;
    background-color: transparent;
    border-right: 1px solid var(--neutral400);
  }

  .column:last-child {
    border-right: none;
  }

  .columnHeader {
    text-align: center;
    background-color: var(--neutral200);
    border-bottom: 1px solid var(--neutral400);
  }

  .columnHeader > p {
    color: var(--neutral800);
    font-weight: 700;
    font-size: 20px;
    margin: 10px 0;
  }

  .row {
    background-color: transparent;
    border: 1px solid transparent;
    transition: 0.3s all;
    border-bottom: 1px solid var(--neutral400);
    border-top: none;
    border-left: none;
    border-right: none;
    text-align: left;
  }

  .row > p {
    color: var(--neutral800);
    font-size: 20px;
    font-weight: 400;
    margin: 10px 0;
    padding-left: 15px;
  }

  .row:hover {
    background-color: var(--neutral200);
  }
</style>
