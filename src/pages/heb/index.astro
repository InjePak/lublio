---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BoxMain from "../../components/BoxMain.astro";
import Button from "../../components/Button.astro";

const pageTitle = "Hebrew";
---

<BaseLayout pageTitle={pageTitle + " | Lublio"}>
  <BoxMain
    title="Hebrew"
    subtitle="עברית"
    description="Hebrew is a language as ancient as the desert sands and as enduring as history itself. The ancient scribes and Agnon breathed profound spirit and modern life into its sacred script, and today, it leaps from the pages of history to resonate warmly in everyday life. Discover a language that embodies both sacred heritage and vibrant modernity."
    language="heb"
  />

  <div class="button-wrapper">
    <Button
      title="히브리어 회화"
      subtitle="ביטויים"
      description="CEFR A1 - B2"
      language="heb"
      path="/hebrew/phrasebook"
      level="phrase"
    />

    <Button
      title="히브리어 패턴"
      subtitle="תבניות"
      description="CEFR B1 - C1"
      language="heb"
      path="/hebrew/pattern"
      level="pattern"
    />
  </div>
</BaseLayout>

<style>
  .button-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1rem;
    margin-top: 3rem;
  }

  /* Mobile */
  @media (max-width: 480px) {
    .button-wrapper {
      gap: 10px;
      margin-bottom: 10px;
    }
  }
</style>
