        language="lux"
        path="/luxembourgish"
      />

      <ButtonMain
        title="Polish"
        subtitle="Polski"
        description="CEFR A1 - C1"
        language="pol"
        path="/polish"
      />

      <ButtonMain
        title="Russian"
        subtitle="Русский"
        description="CEFR A1 - C1"
        language="rus"
        path="/russian"
      />

      <ButtonMain
        title="Swedish"
        subtitle="Svenska"
        description="CEFR A1 - C1"
        language="swe"
        path="/swedish"
      />

      <ButtonMain
        title="Turkish"
        subtitle="Türkçe"
        description="CEFR A1 - C1"
        language="tur"
        path="/turkish"
      />
    </div>
  </div>

  <style>
    .wrapper-intro {
      height: calc(100vh - 3rem);
    }

    /* h2 {
      font-family: "Roboto Condensed", sans-serif;
      margin-top: 1rem;
      font-size: 24px;
      line-height: 34px;
      margin-bottom: 0.5rem;
      font-weight: 600;
    }

    #fixed-title {
      font-family: "Roboto Condensed", sans-serif;
      margin-top: 0px;
      text-transform: uppercase;
      font-size: 40px;
      line-height: 40px;
      margin-bottom: 2rem;
      font-weight: 600;
    } */

    .button-wrapper {
      display: grid;
      height: 100%;
      grid-template-columns: 1fr 1fr 1fr 1fr;
      justify-items: stretch;
      gap: 1.5rem;
      margin-bottom: 1rem;
    }

    @media (max-width: 1280px) {
      .wrapper-intro {
        height: auto;
      }

      .button-wrapper {
        display: flex;
        flex-direction: column;
        height: 100%;
        gap: 1.5rem;
        margin-bottom: 1rem;
      }
    }
  </style>
</BaseLayout>
