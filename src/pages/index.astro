---
import BaseLayout from "../layouts/BaseLayout.astro";
import ButtonMain from "../components/ButtonMain.astro";

const pageTitle = "Lublio";
---

<BaseLayout pageTitle={pageTitle}>
  <main>
    <section class="hero">
      <div class="hero-content">
        <p class="eyebrow">LANGUAGE · TRAVEL · LIFE ABROAD</p>

        <h1>
          Learn languages.<br />
          <span>Live everywhere.</span>
        </h1>

        <p class="hero-description">
          Practical language learning for travelers, digital nomads, and anyone
          building a life across borders.
        </p>

        <a href="#languages" class="hero-button">
          Explore languages
          <span>↓</span>
        </a>
      </div>

      <div class="hero-background" aria-hidden="true">
        <span class="word word-1">Bonjour</span>
        <span class="word word-2">Hallo</span>
        <span class="word word-3">Привет</span>
        <span class="word word-4">Merhaba</span>
        <span class="word word-5">Olá</span>
        <span class="word word-6">Ciao</span>
      </div>
    </section>

    <section id="languages" class="languages">
      <div class="section-header">
        <h2>Choose your language.</h2>
      </div>

      <div class="button-wrapper">
        <ButtonMain
          title="English"
          subtitle="English"
          description="CEFR A1 - C1"
          language="eng"
          path="/english"
        />

        <ButtonMain
          title="French"
          subtitle="Français"
          description="CEFR A1 - C1"
          language="fra"
          path="/french"
        />

        <ButtonMain
          title="German"
          subtitle="Deutsch"
          description="CEFR A1 - C1"
          language="deu"
          path="/german"
        />

        <ButtonMain
          title="Spanish"
          subtitle="Español"
          description="CEFR A1 - C1"
          language="spa"
          path="/spanish"
        />

        <ButtonMain
          title="Italian"
          subtitle="Italiano"
          description="CEFR A1 - C1"
          language="ita"
          path="/italian"
        />

        <ButtonMain
          title="Russian"
          subtitle="Русский"
          description="CEFR A1 - C1"
          language="rus"
          path="/russian"
        />

        <ButtonMain
          title="Portuguese"
          subtitle="Português"
          description="CEFR A1 - C1"
          language="por"
          path="/portuguese"
        />

        <ButtonMain
          title="Turkish"
          subtitle="Türkçe"
          description="CEFR A1 - C1"
          language="tur"
          path="/turkish"
        />

        <ButtonMain
          title="Dutch"
          subtitle="Nederlands"
          description="CEFR A1 - C1"
          language="nld"
          path="/dutch"
        />

        <ButtonMain
          title="Swedish"
          subtitle="Svenska"
          description="CEFR A1 - C1"
          language="swe"
          path="/swedish"
        />

        <ButtonMain
          title="Danish"
          subtitle="Dansk"
          description="CEFR A1 - C1"
          language="dan"
          path="/danish"
        />

        <ButtonMain
          title="Polish"
          subtitle="Polski"
          description="CEFR A1 - C1"
          language="pol"
          path="/polish"
        />

        <ButtonMain
          title="Czech"
          subtitle="Čeština"
          description="CEFR A1 - C1"
          language="ces"
          path="/czech"
        />

        <ButtonMain
          title="Hungarian"
          subtitle="Magyar"
          description="CEFR A1 - C1"
          language="hun"
          path="/hungarian"
        />

        <ButtonMain
          title="Luxembourgish"
          subtitle="Lëtzebuergesch"
          description="CEFR A1 - C1"
          language="lux"
          path="/luxembourgish"
        />
      </div>
    </section>
  </main>

  <style>
    main {
      overflow: hidden;
    }

    /* ─────────────────────────────
       HERO
    ───────────────────────────── */

    .hero {
      position: relative;
      min-height: calc(100vh - 5rem);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 6rem 2rem;
      overflow: hidden;
    }

    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 900px;
      text-align: center;
    }

    h1 {
      margin: 0;
      font-size: clamp(3.5rem, 8vw, 7.5rem);
      line-height: 0.95;
      letter-spacing: -0.055em;
      font-weight: 700;
      font-family: "Google Sans", sans-serif;
    }

    h1 span {
      opacity: 0.35;
    }

    .hero-description {
      max-width: 600px;
      margin: 2rem auto 0;
      font-size: clamp(1rem, 1.5vw, 1.25rem);
      line-height: 1.6;
      opacity: 0.65;
      font-family: "Google Sans", sans-serif;
    }

    .hero-button {
      display: inline-block;
      align-items: center;
      gap: 1rem;
      margin-top: 2.5rem;
      padding: 0.9rem 1.4rem;
      border-radius: 15px;
      background: var(--neutral200);
      color: var(--neutral800);
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 600;
      transition:
        background 0.25s ease,
        color 0.25s ease,
        transform 0.25s ease;
      width: 300px;
      font-family: "Google Sans", sans-serif;
    }

    .hero-button span {
      font-size: 1.1rem;
      transition: transform 0.25s ease;
    }

    .hero-button:hover {
      background: var(--neutral300);
    }

    .hero-button:hover span {
      transform: translateY(3px);
    }

    /* ─────────────────────────────
       FLOATING WORDS
    ───────────────────────────── */

    .hero-background {
      position: absolute;
      inset: 0;
      pointer-events: none;
      user-select: none;
    }

    .word {
      position: absolute;
      font-size: clamp(3rem, 7vw, 8rem);
      font-weight: 700;
      letter-spacing: -0.06em;
      white-space: nowrap;
      opacity: 0.03;
      font-family: "Google Sans", sans-serif;
    }

    .word-1 {
      top: 8%;
      left: -2%;
      transform: rotate(-8deg);
    }

    .word-2 {
      top: 22%;
      right: -4%;
      transform: rotate(7deg);
    }

    .word-3 {
      bottom: 12%;
      left: 3%;
      transform: rotate(5deg);
    }

    .word-4 {
      bottom: 25%;
      right: 4%;
      transform: rotate(-6deg);
    }

    .word-5 {
      top: 45%;
      left: -8%;
      transform: rotate(-12deg);
    }

    .word-6 {
      top: 55%;
      right: -6%;
      transform: rotate(10deg);
    }

    /* ─────────────────────────────
       LANGUAGE SECTION
    ───────────────────────────── */

    .languages {
      max-width: 1400px;
      margin: 0 auto;
      padding: 7rem 0rem 5rem;
    }

    .section-header {
      margin-bottom: 3rem;
    }

    .section-header .eyebrow {
      margin-bottom: 0.75rem;
    }

    h2 {
      margin: 0;
      font-size: clamp(2rem, 4vw, 3.5rem);
      line-height: 1;
      letter-spacing: -0.04em;
    }

    .button-wrapper {
      height: 800px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }

    @media (max-width: 1280px) {
      .languages {
        max-width: 1400px;
        margin: 0 auto;
        padding: 7rem 2rem 5rem;
      }

      h1 {
        margin: 0;
        font-size: 36px;
        line-height: 60px;
        letter-spacing: -0.055em;
        font-weight: 700;
        font-family: "Google Sans", sans-serif;
      }

      .button-wrapper {
        height: auto;
        display: grid;
        grid-template-columns: repeat(1, 1fr);
        gap: 1rem;
      }
    }
  </style>
</BaseLayout>
