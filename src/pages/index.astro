        title="French"
        subtitle="Français"
        description="CEFR A1 - C1"
        language="fra"
        path="/french"
      />

      <ButtonMain
        title="German"
        subtitle="Deutsch"
        description="CEFR A1 - C1"
        language="deu"
        path="/german"
      />

      <ButtonMain
        title="Hungarian"
        subtitle="Magyar"
        description="CEFR A1 - C1"
        language="hun"
        path="/hungarian"
      />

