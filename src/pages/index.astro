        ]}
      />
    </h2>

    <h2 id="fixed-title">당신을 응원합니다 ✨</h2> -->

    <div class="button-wrapper">
      <ButtonMain
        title="Czech"
        subtitle="Čeština"
        description="CEFR A1 - C1"
        language="ces"
        path="/czech"
      />

      <ButtonMain
        title="Danish"
        subtitle="Dansk"
        description="CEFR A1 - C1"
        language="dan"
        path="/danish"
