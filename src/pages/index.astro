---
import BaseLayout from "../layouts/BaseLayout.astro";
import ButtonMain from "../components/ButtonMain.astro";

const pageTitle = "Lublio";

// 15개 언어의 인사말 — 히어로 배경에 흐르는 마키 줄로 사용
const greetings = [
  "Hello",
  "Bonjour",
  "Hallo",
  "Hola",
  "Ciao",
  "Привет",
  "Olá",
  "Merhaba",
  "Hoi",
  "Hej",
  "Goddag",
  "Cześć",
  "Ahoj",
  "Szia",
  "Moien",
];

// 줄마다 시작 위치를 달리해서 같은 단어가 세로로 나란히 놓이지 않게 함
const rows = [0, 4, 8, 12].map((offset) => [
  ...greetings.slice(offset),
  ...greetings.slice(0, offset),
]);
---

<BaseLayout pageTitle={pageTitle}>
  <main>
    <section class="hero">
      <div class="hero-background" aria-hidden="true">
        {
          rows.map((row, i) => (
            <div class={`marquee ${i % 2 === 1 ? "reverse" : ""}`}>
              <div class="marquee-track">
                {[0, 1].map(() => (
                  <div class="marquee-group">
                    {row.map((word) => (
                      <span>{word}</span>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <div class="hero-content">
        <h1>
          <span class="line">Learn languages.</span>
          <span class="line muted">Live everywhere.</span>
        </h1>

        <p class="hero-description">
          Practical language learning for travelers, digital nomads, and anyone
          building a life across borders.
        </p>

        <div class="hero-actions">
          <a href="#languages" class="hero-button">
            <span class="label">Explore languages</span>
            <span class="icon" aria-hidden="true">
              <svg
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M8 3v10M3.5 8.5 8 13l4.5-4.5"></path>
              </svg>
            </span>
          </a>

          <p class="hero-meta">15 languages, from A1 to C1</p>
        </div>
      </div>
    </section>

    <section id="languages" class="languages">
      <div class="section-header">
        <h2>Choose your language.</h2>
      </div>

      <div class="button-wrapper">
        <ButtonMain
          title="English"
          subtitle="English"
          description="CEFR A1 - C1"
          language="eng"
          path="/english"
        />

        <ButtonMain
          title="French"
          subtitle="Français"
          description="CEFR A1 - C1"
          language="fra"
          path="/french"
        />

        <ButtonMain
          title="German"
          subtitle="Deutsch"
          description="CEFR A1 - C1"
          language="deu"
          path="/german"
        />

        <ButtonMain
          title="Spanish"
          subtitle="Español"
          description="CEFR A1 - C1"
          language="spa"
          path="/spanish"
        />

        <ButtonMain
          title="Italian"
          subtitle="Italiano"
          description="CEFR A1 - C1"
          language="ita"
          path="/italian"
        />

        <ButtonMain
          title="Russian"
          subtitle="Русский"
          description="CEFR A1 - C1"
          language="rus"
          path="/russian"
        />

        <ButtonMain
          title="Portuguese"
          subtitle="Português"
          description="CEFR A1 - C1"
          language="por"
          path="/portuguese"
        />

        <ButtonMain
          title="Turkish"
          subtitle="Türkçe"
          description="CEFR A1 - C1"
          language="tur"
          path="/turkish"
        />

        <ButtonMain
          title="Dutch"
          subtitle="Nederlands"
          description="CEFR A1 - C1"
          language="nld"
          path="/dutch"
        />

        <ButtonMain
          title="Swedish"
          subtitle="Svenska"
          description="CEFR A1 - C1"
          language="swe"
          path="/swedish"
        />

        <ButtonMain
          title="Danish"
          subtitle="Dansk"
          description="CEFR A1 - C1"
          language="dan"
          path="/danish"
        />

        <ButtonMain
          title="Polish"
          subtitle="Polski"
          description="CEFR A1 - C1"
          language="pol"
          path="/polish"
        />

        <ButtonMain
          title="Czech"
          subtitle="Čeština"
          description="CEFR A1 - C1"
          language="ces"
          path="/czech"
        />

        <ButtonMain
          title="Hungarian"
          subtitle="Magyar"
          description="CEFR A1 - C1"
          language="hun"
          path="/hungarian"
        />

        <ButtonMain
          title="Luxembourgish"
          subtitle="Lëtzebuergesch"
          description="CEFR A1 - C1"
          language="lux"
          path="/luxembourgish"
        />
      </div>
    </section>
  </main>

  <style>
    main {
      overflow: hidden;
    }

    /* ─────────────────────────────
       HERO
    ───────────────────────────── */

    .hero {
      position: relative;
      min-height: calc(100vh - 5rem);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 6rem 1.5rem;
      overflow: hidden;
    }

    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 900px;
      text-align: center;
    }

    h1 {
      margin: 0;
      font-family: "Google Sans", sans-serif;
      font-size: clamp(2.75rem, 8vw, 7.5rem);
      font-weight: 700;
      line-height: 0.98;
      letter-spacing: -0.055em;
      text-wrap: balance;
    }

    h1 .line {
      display: block;
    }

    h1 .muted {
      opacity: 0.35;
    }

    .hero-description {
      max-width: 34rem;
      margin: 2rem auto 0;
      font-family: "Google Sans", sans-serif;
      font-size: clamp(1rem, 1.5vw, 1.25rem);
      line-height: 1.6;
      opacity: 0.65;
      text-wrap: pretty;
    }

    .hero-actions {
      margin-top: 2.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }

    .hero-button {
      display: inline-flex;
      align-items: center;
      gap: 1.25rem;
      padding: 0.5rem 0.5rem 0.5rem 1.6rem;
      border-radius: 999px;
      background: var(--neutral200);
      color: var(--neutral800);
      text-decoration: none;
      font-family: "Google Sans", sans-serif;
      font-size: 0.95rem;
      font-weight: 600;
      transition: background 0.25s ease;
    }

    .hero-button .icon {
      display: grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 50%;
      background: var(--neutral800);
      color: var(--neutral200);
    }

    .hero-button .icon svg {
      transition: transform 0.25s ease;
    }

    .hero-button:hover {
      background: var(--neutral300);
    }

    .hero-button:hover .icon svg {
      transform: translateY(2px);
    }

    .hero-button:focus-visible {
      outline: 2px solid var(--neutral800);
      outline-offset: 3px;
    }

    .hero-meta {
      margin: 0;
      font-family: "Google Sans", sans-serif;
      font-size: 0.875rem;
      opacity: 0.5;
    }

    /* ─────────────────────────────
       BACKGROUND — 15개 언어 인사말
    ───────────────────────────── */

    .hero-background {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: space-evenly;
      pointer-events: none;
      user-select: none;
      /* 가운데는 비워서 헤드라인이 읽히도록 */
      -webkit-mask-image: radial-gradient(
        ellipse 55% 50% at 50% 50%,
        transparent 0%,
        #000 100%
      );
      mask-image: radial-gradient(
        ellipse 55% 50% at 50% 50%,
        transparent 0%,
        #000 100%
      );
    }

    .marquee {
      overflow: hidden;
    }

    .marquee-track {
      display: flex;
      width: max-content;
      animation: drift 90s linear infinite;
    }

    .marquee.reverse .marquee-track {
      animation-direction: reverse;
      animation-duration: 110s;
    }

    .marquee-group {
      display: flex;
      flex-shrink: 0;
      gap: 3.5rem;
      padding-right: 3.5rem;
    }

    .marquee-group span {
      font-family: "Google Sans", sans-serif;
      font-size: clamp(2.5rem, 6vw, 5.5rem);
      font-weight: 700;
      letter-spacing: -0.05em;
      white-space: nowrap;
      opacity: 0.07;
    }

    @keyframes drift {
      from {
        transform: translateX(0);
      }
      to {
        transform: translateX(-50%);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .marquee-track {
        animation: none;
      }
    }

    /* ─────────────────────────────
       LANGUAGE SECTION
    ───────────────────────────── */

    .languages {
      max-width: 1400px;
      margin: 0 auto;
      padding: 7rem 0rem 5rem;
    }

    .section-header {
      margin-bottom: 3rem;
    }

    h2 {
      margin: 0;
      font-size: clamp(2rem, 4vw, 3.5rem);
      line-height: 1;
      letter-spacing: -0.04em;
    }

    .button-wrapper {
      height: 800px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }

    @media (max-width: 1280px) {
      .languages {
        max-width: 1400px;
        margin: 0 auto;
        padding: 7rem 2rem 5rem;
      }

      .button-wrapper {
        height: auto;
        display: grid;
        grid-template-columns: repeat(1, 1fr);
        gap: 1rem;
      }
    }
  </style>
</BaseLayout>