---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BoxMain from "../../components/BoxMain.astro";
import Button from "../../components/Button.astro";

const pageTitle = "Dutch";
---

<BaseLayout pageTitle={pageTitle + " | Lublio"}>
  <BoxMain
    title="Dutch"
    subtitle="Nederlands"
    description="Dutch is the language of clarity and directness. When merchants negotiate across borders, communities build together with honest words, and innovators solve problems with elegant simplicity, Dutch cuts through complexity without losing warmth. Pragmatic yet surprisingly poetic, it's a language that makes thinking clearer and connection warmer."
    language="nld"
  />

  <div class="button-wrapper">
    <Button
      title="Zinnen"
      subtitle="Phrasebook"
      description="CEFR A1 - B2"
      language="nld"
      path="/dutch/phrasebook"
      level="phrase"
    />

    <Button
      title="Patronen"
      subtitle="Speaking Pattern"
      description="CEFR B1 - C1"
      language="nld"
      path="/dutch/pattern"
      level="pattern"
    />
  </div>
</BaseLayout>

<style>
  .button-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  /* Mobile */
  @media (max-width: 480px) {
    .button-wrapper {
      gap: 10px;
      margin-bottom: 10px;
    }
  }
</style>
