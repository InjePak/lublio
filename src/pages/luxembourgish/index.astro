---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BoxMain from "../../components/BoxMain.astro";
import Button from "../../components/Button.astro";

const pageTitle = "Luxembourgish";
---

<BaseLayout pageTitle={pageTitle + " | Lublio"}>
  <BoxMain
    title="Luxembourgish"
    subtitle="Lëtzebuergesch"
    description="Luxembourgish is the language of three worlds meeting. When cultures blend at crossroads, polyglots navigate between identities, and voices find strength in multiplicity, Luxembourgish bridges divides with quiet resilience. Intimate yet globally aware, it's a language that celebrates both roots and boundless possibility."
    language="lux"
  />

  <div class="button-wrapper">
    <Button
      title="Ausdrëck"
      subtitle="Phrasebook"
      description="CEFR A1 - B2"
      language="lux"
      path="/luxembourgish/phrasebook"
      level="phrase"
    />

    <Button
      title="Struktur"
      subtitle="Speaking Pattern"
      description="CEFR B1 - C1"
      language="lux"
      path="/luxembourgish/pattern"
      level="pattern"
    />
  </div>
</BaseLayout>

<style>
  .button-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  /* Mobile */
  @media (max-width: 480px) {
    .button-wrapper {
      gap: 10px;
      margin-bottom: 10px;
    }
  }
</style>
