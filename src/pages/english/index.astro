---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BoxMain from "../../components/BoxMain.astro";
import Button from "../../components/Button.astro";

const pageTitle = "English";
---

<BaseLayout pageTitle={pageTitle + " | Lublio"}>
  <BoxMain
    title="English"
    description="English is the language the world has chosen to understand one another. Whether it’s a negotiation table in New York, a conversation in a London pub, or a startup pitch in Mumbai, it all happens in English. Discover a language that works anywhere and connects you with anyone."
    language="eng"
  />

  <div class="button-wrapper">
    <Button
      title="Phrases"
      subtitle="Phrasebook"
      description="CEFR A1 - B2"
      language="eng"
      path="/english/phrasebook"
      level="phrase"
    />

    <Button
      title="Patterns"
      subtitle="Speaking Pattern"
      description="CEFR B1 - C1"
      language="eng"
      path="/english/pattern"
      level="pattern"
    />

    <!-- <Button
      title="종합 영어"
      subtitle="English"
      description="CEFR A1 - B2"
      language="eng"
      path="/english/composite"
      level="composite"
      isDev="true"
    /> -->

    <!-- <Button
      title="Словарь"
      subtitle="Vocabulary"
      description="CEFR A1 - C1"
      language="eng"
      path="/english/vocabulary"
      level="vocabulary"
      isDev="true"
    /> -->
  </div>
</BaseLayout>

<style>
  .button-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1rem;
    margin-top: 3rem;
  }

  /* Mobile */
  @media (max-width: 480px) {
    .button-wrapper {
      gap: 10px;
      margin-bottom: 10px;
    }
  }
</style>
