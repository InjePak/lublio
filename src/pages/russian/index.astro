---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BoxMain from "../../components/BoxMain.astro";
import Button from "../../components/Button.astro";

const pageTitle = "Russian";
---

<BaseLayout pageTitle={pageTitle + " | Lublio"}>
  <BoxMain
    title="Russian"
    subtitle="Русский"
    description="Russian is as vast as the continent and as deep as a northern winter. Tolstoy and Dostoevsky unraveled the human soul through its prose, and today it connects hundreds of millions of voices across Eurasia. Experience a language of grand scale and intricate emotional depth."
    language="rus"
  />

  <div class="button-wrapper">
    <Button
      title="Фразы"
      subtitle="Phrasebook"
      description="CEFR A1 - B2"
      language="rus"
      path="/russian/phrasebook"
      level="phrase"
    />

    <Button
      title="Схемы"
      subtitle="Speaking Pattern"
      description="CEFR B1 - C1"
      language="rus"
      path="/russian/pattern"
      level="pattern"
    />
  </div>
</BaseLayout>

<style>
  .button-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1rem;
    margin-top: 3rem;
  }

  /* Mobile */
  @media (max-width: 480px) {
    .button-wrapper {
      gap: 10px;
      margin-bottom: 10px;
    }
  }
</style>
