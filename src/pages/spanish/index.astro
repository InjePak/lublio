---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BoxMain from "../../components/BoxMain.astro";
import Button from "../../components/Button.astro";

const pageTitle = "Spanish";
---

<BaseLayout pageTitle={pageTitle + " | Lublio"}>
  <BoxMain
    title="Spanish"
    subtitle="Español"
    description="Spanish is a language as radiant as the sun and as expansive as the ocean. Cervantes and Márquez pushed the boundaries between reality and imagination with their words, and today, it sets hundreds of millions of voices ablaze across two continents. Discover a language that embodies both passionate scale and sensory rhythm."
    language="spa"
  />

  <div class="button-wrapper">
    <Button
      title="Frases"
      subtitle="Phrasebook"
      description="CEFR A1 - B2"
      language="spa"
      path="/spanish/phrasebook"
      level="phrase"
    />

    <Button
      title="Patrones"
      subtitle="Speaking Pattern"
      description="CEFR B1 - C1"
      language="spa"
      path="/spanish/pattern"
      level="pattern"
    />
  </div>
</BaseLayout>

<style>
  .button-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  /* Mobile */
  @media (max-width: 480px) {
    .button-wrapper {
      gap: 10px;
      margin-bottom: 10px;
    }
  }
</style>
