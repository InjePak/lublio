---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BoxMain from "../../components/BoxMain.astro";
import Button from "../../components/Button.astro";

const pageTitle = "German";
---

<BaseLayout pageTitle={pageTitle + " | Lublio"}>
  <BoxMain
    title="German"
    subtitle="Deutsch"
    description="German is the language of deep thought. When philosophers question existence, engineers design the modern world, and poets stand in awe of nature, German captures that weight with absolute precision. Precise yet surprisingly lyrical, it’s a language that pushes your thinking further."
    language="deu"
  />

  <div class="button-wrapper">
    <Button
      title="Sätze"
      subtitle="Phrasebook"
      description="CEFR A1 - B2"
      language="deu"
      path="/german/phrasebook"
      level="phrase"
    />

    <Button
      title="Muster"
      subtitle="Speaking Pattern"
      description="CEFR B1 - C1"
      language="deu"
      path="/german/pattern"
      level="pattern"
    />
  </div>
</BaseLayout>

<style>
  .button-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  /* Mobile */
  @media (max-width: 480px) {
    .button-wrapper {
      gap: 10px;
      margin-bottom: 10px;
    }
  }
</style>
