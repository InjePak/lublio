---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BoxMain from "../../components/BoxMain.astro";
import Button from "../../components/Button.astro";

const pageTitle = "French";
---

<BaseLayout pageTitle={pageTitle + " | Lublio"}>
  <BoxMain
    title="French"
    subtitle="Français"
    description="French turns every slice of daily life into an art form. A casual café chat, bargaining at a local market, or a simple greeting to a stranger—everything takes on a richer tone through French. Step into a language that helps you see the world with a bit more beauty."
    language="fra"
  />

  <div class="button-wrapper">
    <Button
      title="Phrases"
      subtitle="Phrasebook"
      description="CEFR A1 - B2"
      language="fra"
      path="/french/phrasebook"
      level="phrase"
    />

    <Button
      title="Modèles"
      subtitle="Speaking Pattern"
      description="CEFR B1 - C1"
      language="fra"
      path="/french/pattern"
      level="pattern"
    />
  </div>
</BaseLayout>

<style>
  .button-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1rem;
    margin-top: 3rem;
  }

  /* Mobile */
  @media (max-width: 480px) {
    .button-wrapper {
      gap: 10px;
      margin-bottom: 10px;
    }
  }
</style>
