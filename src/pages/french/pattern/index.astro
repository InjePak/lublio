---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Box2 from "../../../components/Box2.astro";
import Button2 from "../../../components/Button2.astro";

import chapters from "../../../assets/json/patterns/chapters.json";

const pageTitle = "French Speaking Pattern";
---

<BaseLayout pageTitle={pageTitle + " | Lublio"}>
  <Box2
    title="Modèles"
    subtitle="French Speaking Pattern"
    description="Try creating tens of thousands of sentences using just one pattern. No need to worry about complicated grammar rules. Experience the most efficient way to quickly improve your conversational skills."
    language="fra"
  />

  <section>
    <h2>
      <span class="animated-underline-fra">CEFR B1 - C1</span>
    </h2>

    <ul>
      {
        chapters.map((post: any) => (
          <Button2
            id={post.id}
            title={post.fra}
            subtitle={post.eng}
            language="fra"
            path={"/french/pattern/" + post.path}
          />
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  section > ul {
    display: grid;
    height: 100%;
    grid-template-columns: 1fr;
    justify-items: stretch;
    gap: 1.5rem;
    margin-bottom: 0rem;
  }

  @media (max-width: 1280px) {
    section > h2 {
      margin-left: 1rem;
    }

    section > ul {
      display: flex;
      flex-direction: column;
      height: 100%;
      gap: 0rem;
      margin-bottom: 0rem;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const selectors = [
      ".animated-underline",
      ".animated-underline-eng",
      ".animated-underline-fra",
      ".animated-underline-deu",
      ".animated-underline-rus",
      ".animated-underline-esp",
      ".animated-underline-ita",
      ".animated-underline-nld",
      ".animated-underline-swe",
      ".animated-underline-dan",
      ".animated-underline-lux",
      ".animated-underline-tur",
      ".animated-underline-pol",
      ".animated-underline-ces",
      ".animated-underline-hun",
      ".animated-underline-heb",
      ".animated-underline-kaz",
    ];

    document.querySelectorAll(selectors.join(", ")).forEach((el) => {
      el.classList.add("is-active");
    });
  });
</script>
