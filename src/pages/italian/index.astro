---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BoxMain from "../../components/BoxMain.astro";
import Button from "../../components/Button.astro";

const pageTitle = "Italian";
---

<BaseLayout pageTitle={pageTitle + " | Lublio"}>
  <BoxMain
    title="Italian"
    subtitle="Italiano"
    description="Italian is as radiant as art and as warm as Mediterranean sunlight. Dante and Leonardo carved the spirit of the Renaissance with its words, and today it still sings of the beauty of life across the region. Discover a language that blends sensual cadence with timeless classicism."
    language="ita"
  />

  <div class="button-wrapper">
    <Button
      title="Frasi"
      subtitle="Phrasebook"
      description="CEFR A1 - B2"
      language="ita"
      path="/italian/phrasebook"
      level="phrase"
    />

    <Button
      title="Strutture"
      subtitle="Speaking Pattern"
      description="CEFR B1 - C1"
      language="ita"
      path="/italian/pattern"
      level="pattern"
    />
  </div>
</BaseLayout>

<style>
  .button-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  /* Mobile */
  @media (max-width: 480px) {
    .button-wrapper {
      gap: 10px;
      margin-bottom: 10px;
    }
  }
</style>
