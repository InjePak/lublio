---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SectionSwitcher from "../../../../components/SectionSwitcher.astro";
import Box3 from "../../../../components/Box3.astro";

import chapters from "../../../../assets/json/patterns/chapters.json";
import chapter1 from "../../../../assets/json/patterns/turkish/chapter1.json";
import chapter2 from "../../../../assets/json/patterns/turkish/chapter2.json";
import chapter3 from "../../../../assets/json/patterns/turkish/chapter3.json";
import chapter4 from "../../../../assets/json/patterns/turkish/chapter4.json";
import chapter5 from "../../../../assets/json/patterns/turkish/chapter5.json";
import chapter6 from "../../../../assets/json/patterns/turkish/chapter6.json";
import chapter7 from "../../../../assets/json/patterns/turkish/chapter7.json";
import chapter8 from "../../../../assets/json/patterns/turkish/chapter8.json";
import chapter9 from "../../../../assets/json/patterns/turkish/chapter9.json";
import chapter10 from "../../../../assets/json/patterns/turkish/chapter10.json";

export async function getStaticPaths() {
  // 모든 경로의 조합을 생성합니다.
  // 챕터 목록(chapters)과 각 챕터의 상세 데이터(chapter1 등)를 결합해야 합니다.

  return chapters.flatMap((chapter) => {
    let jsonData;
    switch (chapter.id) {
      case 1:
        jsonData = chapter1;
        break;
      case 2:
        jsonData = chapter2;
        break;
      case 3:
        jsonData = chapter3;
        break;
      case 4:
        jsonData = chapter4;
        break;
      case 5:
        jsonData = chapter5;
        break;
      case 6:
        jsonData = chapter6;
        break;
      case 7:
        jsonData = chapter7;
        break;
      case 8:
        jsonData = chapter8;
        break;
      case 9:
        jsonData = chapter9;
        break;
      case 10:
        jsonData = chapter10;
        break;
      default:
        jsonData = chapter1;
        break;
    }

    const slug = chapter.path.split("/").filter(Boolean).pop();

    return jsonData.map((post) => ({
      params: {
        path: slug, // [path] 부분에 들어갈 값
        pattern: post.id.toString(), // [pattern] 부분에 들어갈 값
      },
      props: {
        post,
      },
    }));
  });
}

// Astro.params를 통해 URL의 모든 변수를 가져옵니다.
const { path, pattern } = Astro.params;
// getStaticPaths의 props에서 데이터를 가져옵니다.
const { post } = Astro.props;

// Section Switcher
const tabItems = [
  { id: "phrase-b1", label: "B1" },
  { id: "phrase-b2", label: "B2" },
  { id: "phrase-c1", label: "C1" },
];
---

<BaseLayout pageTitle={post.pattern + " | Lublio"}>
  <Box3
    title=`${post.id}. ${post.pattern}`
    subtitle={post.translation}
    language="tur"
  />
  <SectionSwitcher items={tabItems} />

  <br />

  {
    !post ? (
      <p>Internal Server Error</p>
    ) : (
      <>
        {[
          { data: post.b1, className: "phrase-b1" },
          { data: post.b2, className: "phrase-b2" },
          { data: post.c1, className: "phrase-c1" },
        ]
          .filter((item) => item.data)
          .map(({ data, className }) => (
            <div class={`phrase-box ${className} riseUp_1`}>
              {data.map((phrase, i) => (
                <p lang="tr">
                  <span>{i + 1}</span>
                  <br />
                  <img
                    alt="Turkey"
                    src="https://purecatamphetamine.github.io/country-flag-icons/3x2/TR.svg"
                  />
                  {phrase}
                </p>
              ))}
            </div>
          ))}
      </>
    )
  }

  <script>
    // 페이지 내의 모든 체크박스를 가져옵니다.
    const toggles = document.querySelectorAll(".toggle-lang");

    toggles.forEach((toggle) => {
      toggle.addEventListener("change", (e) => {
        const targetClass = (e.target as HTMLInputElement).dataset.target;
        const isVisible = (e.target as HTMLInputElement).checked;

        // 해당 클래스를 가진 모든 요소를 찾아 숨기거나 보입니다.
        const elements = document.querySelectorAll(`.${targetClass}`);
        elements.forEach((el) => {
          (el as HTMLElement).style.display = isVisible ? "block" : "none";
        });
      });
    });
  </script>
</BaseLayout>

<style>
  .phrase-box {
    margin-bottom: 1.5rem;
  }

  .phrase-box > h2 {
    text-align: left;
  }

  .phrase-box > p {
    display: inline-block;
    text-align: left;
    width: 100%;
    padding: 2.5rem 3rem;
    font-size: 18px;
    font-weight: 500;
    line-height: 2rem;
    margin-bottom: 1.5rem;
    hyphens: auto;
    overflow-wrap: break-word;
    font-family: "Inter", sans-serif;
    background-color: var(--white);
    border-radius: 10px;
  }

  .phrase-box > p > span {
    display: inline-block;
    text-transform: uppercase;
    width: 100%;
    font-weight: 500;
    direction: ltr;
    color: var(--neutral700);
    border-bottom: 1px solid var(--neutral700);
    margin-bottom: 2rem;
  }

  .phrase-box > p > img {
    display: inline-block;
    height: 16px;
    transform: translateY(2px);
    border-radius: 2px;
    margin-right: 0.5rem;
  }

  .phrase-box > h1,
  .phrase-box > p {
    color: var(--neutral800);
  }

  @media (max-width: 1280px) {
    .phrase-box > p {
      padding: 2rem;
      font-size: 16px;
      line-height: 26px;
      margin-bottom: 1rem;
      border: none;
      border-radius: 0px;
    }

    .phrase-box > p > img {
      display: block;
      height: 14px;
      transform: translateY(0px);
      border-radius: 2px;
      margin-bottom: 1rem;
    }

    .phrase-box > h1,
    .phrase-box > p {
      color: var(--neutral800);
    }
  }
</style>
