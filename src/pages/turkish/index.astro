---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BoxMain from "../../components/BoxMain.astro";
import Button from "../../components/Button.astro";

const pageTitle = "Turkish";
---

<BaseLayout pageTitle={pageTitle + " | Lublio"}>
  <BoxMain
    title="Turkish"
    subtitle="Türkçe"
    description="Turkish carries the breadth of two continents and the depth of centuries of history. Ottoman writers wove the wisdom of East and West through its syntax, and it continues to unite voices across the Eurasian crossroads today. Explore a language that pairs breathtaking scale with subtle, elegant detail."
    language="tur"
  />

  <div class="button-wrapper">
    <Button
      title="Cümleler"
      subtitle="Phrasebook"
      description="CEFR A1 - B2"
      language="tur"
      path="/turkish/phrasebook"
      level="phrase"
    />

    <Button
      title="Kalıplar"
      subtitle="Speaking Pattern"
      description="CEFR B1 - C1"
      language="tur"
      path="/turkish/pattern"
      level="pattern"
    />
  </div>
</BaseLayout>

<style>
  .button-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  /* Mobile */
  @media (max-width: 480px) {
    .button-wrapper {
      gap: 10px;
      margin-bottom: 10px;
    }
  }
</style>
