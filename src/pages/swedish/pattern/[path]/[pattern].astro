---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SectionSwitcher from "../../../../components/SectionSwitcher.astro";
import Box3 from "../../../../components/Box3.astro";
import PhraseBox from "../../../../components/PhraseBox.astro";

import chapters from "../../../../assets/json/patterns/chapters.json";
import chapter1 from "../../../../assets/json/patterns/swedish/chapter1.json";
import chapter2 from "../../../../assets/json/patterns/swedish/chapter2.json";
import chapter3 from "../../../../assets/json/patterns/swedish/chapter3.json";
import chapter4 from "../../../../assets/json/patterns/swedish/chapter4.json";
import chapter5 from "../../../../assets/json/patterns/swedish/chapter5.json";
import chapter6 from "../../../../assets/json/patterns/swedish/chapter6.json";
import chapter7 from "../../../../assets/json/patterns/swedish/chapter7.json";
import chapter8 from "../../../../assets/json/patterns/swedish/chapter8.json";
import chapter9 from "../../../../assets/json/patterns/swedish/chapter9.json";
import chapter10 from "../../../../assets/json/patterns/swedish/chapter10.json";

export async function getStaticPaths() {
  // 모든 경로의 조합을 생성합니다.
  // 챕터 목록(chapters)과 각 챕터의 상세 데이터(chapter1 등)를 결합해야 합니다.

  return chapters.flatMap((chapter) => {
    let jsonData;
    switch (chapter.id) {
      case 1:
        jsonData = chapter1;
        break;
      case 2:
        jsonData = chapter2;
        break;
      case 3:
        jsonData = chapter3;
        break;
      case 4:
        jsonData = chapter4;
        break;
      case 5:
        jsonData = chapter5;
        break;
      case 6:
        jsonData = chapter6;
        break;
      case 7:
        jsonData = chapter7;
        break;
      case 8:
        jsonData = chapter8;
        break;
      case 9:
        jsonData = chapter9;
        break;
      case 10:
        jsonData = chapter10;
        break;
      default:
        jsonData = chapter1;
        break;
    }

    const slug = chapter.path.split("/").filter(Boolean).pop();

    return jsonData.map((post) => ({
      params: {
        path: slug, // [path] 부분에 들어갈 값
        pattern: post.id.toString(), // [pattern] 부분에 들어갈 값
      },
      props: {
        post,
      },
    }));
  });
}

// Astro.params를 통해 URL의 모든 변수를 가져옵니다.
const { path, pattern } = Astro.params;
// getStaticPaths의 props에서 데이터를 가져옵니다.
const { post } = Astro.props;

// Section Switcher
const tabItems = [
  { id: "phrase-b1", label: "B1" },
  { id: "phrase-b2", label: "B2" },
  { id: "phrase-c1", label: "C1" },
];
---

<BaseLayout pageTitle={post.pattern + " | Lublio"}>
  <Box3
    title=`${post.id}. ${post.pattern}`
    subtitle={post.translation}
    language="swe"
  />
  <SectionSwitcher items={tabItems} />

  <br />

  {
    !post ? (
      <p>Internal Server Error</p>
    ) : (
      <>
        {[
          { data: post.b1, className: "phrase-b1" },
          { data: post.b2, className: "phrase-b2" },
          { data: post.c1, className: "phrase-c1" },
        ]
          .filter((item) => item.data)
          .map(({ data, className }) => (
            <PhraseBox data={data} className={className} language="swe" />
          ))}
      </>
    )
  }
</BaseLayout>
