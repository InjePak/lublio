---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BoxMain from "../../components/BoxMain.astro";
import Button from "../../components/Button.astro";

const pageTitle = "Swedish";
---

<BaseLayout pageTitle={pageTitle + " | Lublio"}>
  <BoxMain
    title="Swedish"
    subtitle="Svenska"
    description="Swedish is the language of balance and elegance. When designers seek harmony, nature speaks in whispered wisdom, and thinkers contemplate the infinite, Swedish captures both stillness and movement. Minimalist yet profoundly expressive, it's a language that aligns your mind with clarity and grace."
    language="swe"
  />

  <div class="button-wrapper">
    <Button
      title="Fraser"
      subtitle="Phrasebook"
      description="CEFR A1 - B2"
      language="swe"
      path="/swedish/phrasebook"
      level="phrase"
    />

    <Button
      title="Mönster"
      subtitle="Speaking Pattern"
      description="CEFR B1 - C1"
      language="swe"
      path="/swedish/pattern"
      level="pattern"
    />
  </div>
</BaseLayout>

<style>
  .button-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  /* Mobile */
  @media (max-width: 480px) {
    .button-wrapper {
      gap: 10px;
      margin-bottom: 10px;
    }
  }
</style>
