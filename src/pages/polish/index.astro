---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BoxMain from "../../components/BoxMain.astro";
import Button from "../../components/Button.astro";

const pageTitle = "Polish";
---

<BaseLayout pageTitle={pageTitle + " | Lublio"}>
  <BoxMain
    title="Polish"
    subtitle="Polski"
    description="Polish is a language as poetic as a Chopin melody and as noble as its history of enduring trial. Sienkiewicz and Szymborska exquisitely captured the song of the soul and the fleeting moments of life, and today, it connects the pride of tens of millions at the heart of Eastern Europe. Discover a language that embodies both solid narrative and fine rhythm."
    language="pol"
  />

  <div class="button-wrapper">
    <Button
      title="Zwroty"
      subtitle="Phrasebook"
      description="CEFR A1 - B2"
      language="pol"
      path="/polish/phrasebook"
      level="phrase"
    />

    <Button
      title="Wzorce"
      subtitle="Speaking Pattern"
      description="CEFR B1 - C1"
      language="pol"
      path="/polish/pattern"
      level="pattern"
    />
  </div>
</BaseLayout>

<style>
  .button-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  /* Mobile */
  @media (max-width: 480px) {
    .button-wrapper {
      gap: 10px;
      margin-bottom: 10px;
    }
  }
</style>
