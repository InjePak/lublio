---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BoxMain from "../../components/BoxMain.astro";
import Button from "../../components/Button.astro";

const pageTitle = "Kazakh";
---

<BaseLayout pageTitle={pageTitle + " | Lublio"}>
  <BoxMain
    title="Kazakh"
    subtitle="Қазақша"
    description="Kazakh is a language as vast as the endless steppe and as free as the mountain wind. Abai and Auezov reflected the soul of the nomadic spirit and the timeless wisdom of the land through their words, and today, it resounds with pride across the heart of Central Asia. Discover a language that embodies both majestic breadth and poetic depth."
    language="kaz"
  />

  <div class="button-wrapper">
    <Button
      title="카자흐어 회화"
      subtitle="Фразалар"
      description="CEFR A1 - B2"
      language="kaz"
      path="/kazakh/phrasebook"
      level="phrase"
    />

    <Button
      title="카자흐어 패턴"
      subtitle="Үлгілер"
      description="CEFR B1 - C1"
      language="kaz"
      path="/kazakh/pattern"
      level="pattern"
    />

    <!-- <Button
      title="카자흐어 문법"
      subtitle="Грамматика"
      description="CEFR A0 - C1"
      language="kaz"
      path="/kazakh/grammar"
      level="grammar"
      isDev="true"
    /> -->
  </div>
</BaseLayout>

<style>
  .button-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1rem;
    margin-top: 3rem;
  }

  /* Mobile */
  @media (max-width: 480px) {
    .button-wrapper {
      gap: 10px;
      margin-bottom: 10px;
    }
  }
</style>
