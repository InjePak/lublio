---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BoxMain from "../../components/BoxMain.astro";
import Button from "../../components/Button.astro";

const pageTitle = "Portuguese";
---

<BaseLayout pageTitle={pageTitle + " | Lublio"}>
  <BoxMain
    title="Portuguese"
    subtitle="Português"
    description="Portuguese is a language as vibrant as the tropical sun and as wide as the ocean winds. Camões and Amado wove tales of human fate and boundless romance with their prose, and today, it sparks millions of passionate voices from Europe to South America. Discover a language that embodies both heroic scale and deep, lyrical warmth."
    language="por"
  />

  <div class="button-wrapper">
    <Button
      title="Frases"
      subtitle="Phrasebook"
      description="CEFR A1 - B2"
      language="por"
      path="/portuguese/phrasebook"
      level="phrase"
    />

    <Button
      title="Padrões"
      subtitle="Speaking Pattern"
      description="CEFR B1 - C1"
      language="por"
      path="/portuguese/pattern"
      level="pattern"
    />
  </div>
</BaseLayout>

<style>
  .button-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  /* Mobile */
  @media (max-width: 480px) {
    .button-wrapper {
      gap: 10px;
      margin-bottom: 10px;
    }
  }
</style>
