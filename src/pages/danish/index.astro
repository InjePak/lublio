---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BoxMain from "../../components/BoxMain.astro";
import Button from "../../components/Button.astro";

const pageTitle = "Danish";
---

<BaseLayout pageTitle={pageTitle + " | Lublio"}>
  <BoxMain
    title="Danish"
    subtitle="Dansk"
    description="Danish is the language of warmth and comfort. When friends gather to share life's moments, storytellers weave tales of belonging, and hearts recognize the simple beauty of togetherness, Danish wraps meaning in genuine ease. Conversational yet thoughtfully nuanced, it's a language that invites both laughter and reflection."
    language="dan"
  />

  <div class="button-wrapper">
    <Button
      title="Vendinger"
      subtitle="Phrasebook"
      description="CEFR A1 - B2"
      language="dan"
      path="/danish/phrasebook"
      level="phrase"
    />

    <Button
      title="Mønstre"
      subtitle="Speaking Pattern"
      description="CEFR B1 - C1"
      language="dan"
      path="/danish/pattern"
      level="pattern"
    />
  </div>
</BaseLayout>

<style>
  .button-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  /* Mobile */
  @media (max-width: 480px) {
    .button-wrapper {
      gap: 10px;
      margin-bottom: 10px;
    }
  }
</style>
