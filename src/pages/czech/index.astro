---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BoxMain from "../../components/BoxMain.astro";
import Button from "../../components/Button.astro";

const pageTitle = "Czech";
---

<BaseLayout pageTitle={pageTitle + " | Lublio"}>
  <BoxMain
    title="Czech"
    subtitle="Čeština"
    description="Czech is a language as elegant as the Prague night sky and as profound as a Bohemian fortress. Kafka and Kundera unravelled the labyrinth of life and the weight of being with brilliant wit, and today, it illuminates the intellect of tens of millions at the heart of Central Europe. Discover a language that embodies both intellectual wit and romantic texture."
    language="ces"
  />

  <div class="button-wrapper">
    <Button
      title="Fráze"
      subtitle="Phrasebook"
      description="CEFR A1 - B2"
      language="ces"
      path="/czech/phrasebook"
      level="phrase"
    />

    <Button
      title="Vzory"
      subtitle="Speaking Pattern"
      description="CEFR B1 - C1"
      language="ces"
      path="/czech/pattern"
      level="pattern"
    />
  </div>
</BaseLayout>

<style>
  .button-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  /* Mobile */
  @media (max-width: 480px) {
    .button-wrapper {
      gap: 10px;
      margin-bottom: 10px;
    }
  }
</style>
